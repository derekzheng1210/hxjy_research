# 数据目录根路径（运行态数据外置于此）
# 留空或不设则默认使用项目同级 ../juyuan_credit_data
# 迁移到新机器时复制本文件为 .env 并改成本机路径
# Windows 示例: PORTAL_DATA_ROOT=D:\信用债研究\juyuan_credit_data
# Linux   示例: PORTAL_DATA_ROOT=/opt/juyuan_credit_data
# PORTAL_DATA_ROOT=

# 机构行为监测上游数据源（默认 http://43.137.12.140:8000）
# INSTITUTION_FLOW_UPSTREAM=http://43.137.12.140:8000/bondflow/api
# INSTITUTION_FLOW_UPSTREAM_PAGE=http://43.137.12.140:8000/jgxw/

# 数据爬虫账号（不写入代码，仅环境配置；缺失时对应抓取任务会给出明确报错）
# DM 经纪商行情（DealingMatrix，web.innodealing.com）——二级择券工具的挂盘行情来源
# DM_USERNAME=your-dm-username
# DM_PASSWORD=your-dm-password
# 信评门户（IAM 统一认证 iam.hxjyam.com）——内评/对手限额/持仓数据来源
# IAM_USERNAME=your-iam-username
# IAM_PASSWORD=your-iam-password

# 站点安全配置（公网部署前必须显式设置；未设置时使用代码内置默认值并在启动日志告警）
# SITE_PASSWORD=your-password
# ADMIN_PASSWORD=your-admin-password
# SECRET_KEY=change-this-secret

# 大模型配置：自部署模型（阿里云 OpenAI 兼容网关）优先，MiMo 兜底，DeepSeek 二层兜底。
# 密钥不写入代码：优先读环境变量，Windows 下回退读注册表 HKCU\Environment。
# 智能补全 / 知识搜索 / 路演文本识别 / 路演报告自动匹配统一走此配置；
# 自部署模型失败自动回退 MiMo，再失败回退 DeepSeek。
# SELF_LLM_API_KEY=sk-...
# SELF_LLM_BASE_URL=http://10.9.50.201:3005/v1
# SELF_LLM_MODEL=glm-5.2
# MIMO_API_KEY=sk-...
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
