# 数据目录根路径（运行态数据外置于此）
# 留空或不设则默认使用项目同级 ../juyuan_credit_data
# 迁移到新机器时复制本文件为 .env 并改成本机路径
# Windows 示例: PORTAL_DATA_ROOT=D:\信用债研究\juyuan_credit_data
# Linux   示例: PORTAL_DATA_ROOT=/opt/juyuan_credit_data
# PORTAL_DATA_ROOT=

# 机构行为监测上游数据源（默认 http://43.137.12.140:8000）
# INSTITUTION_FLOW_UPSTREAM=http://43.137.12.140:8000/bondflow/api
# INSTITUTION_FLOW_UPSTREAM_PAGE=http://43.137.12.140:8000/jgxw/

# 站点安全配置（公网部署前必须显式设置；未设置时使用代码内置默认值并在启动日志告警）
# SITE_PASSWORD=your-password
# ADMIN_PASSWORD=your-admin-password
# SECRET_KEY=change-this-secret

# 大模型配置：默认 MiMo（小米开放平台，OpenAI 兼容），DeepSeek 兜底。
# 密钥不写入代码：优先读环境变量，Windows 下回退读注册表 HKCU\Environment。
# 智能补全 / 知识搜索 / 路演文本识别统一走此配置；MiMo 失败自动回退 DeepSeek。
# MIMO_API_KEY=sk-...
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5
# DEEPSEEK_API_KEY=sk-...
