# Replace credit-tools.example.com and the certificate paths before enabling.
server {
    listen 80;
    server_name credit-tools.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name credit-tools.example.com;

    ssl_certificate     /etc/letsencrypt/live/credit-tools.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/credit-tools.example.com/privkey.pem;
    client_max_body_size 110m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        application/javascript application/json application/xml image/svg+xml
        text/css text/javascript text/plain text/xml;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Let Nginx compress in production; Flask compression remains a direct-access fallback.
        proxy_set_header Accept-Encoding "";
        proxy_buffering on;
        proxy_buffers 16 64k;
        proxy_busy_buffers_size 256k;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
