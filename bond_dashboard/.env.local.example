# 复制本文件为 .env.local 并填入你的真实凭证
# DM 数据源凭证（必填，否则债券/估值数据无法拉取）
INNO_APP_KEY=
INNO_APP_SECRET=

# 企业微信机器人 Webhook（用于消息推送/海报推送，可选）
WECHAT_WEBHOOK=

# 主体内评数据文件（信评门户 portal_data.json，由研究门户每日任务更新；
# 按主体全称匹配，不配置或文件缺失时全站内评列显示"-"，不影响其他功能）
# INTERNAL_RATINGS_FILE=D:/信用债研究/完整网页内容/juyuan_credit_data/data/portal_data.json

# DM 每日自动刷新时间（24 小时制，默认 19:00；服务器启动后内建调度器自动执行）
# DM_REFRESH_AT=19:00
