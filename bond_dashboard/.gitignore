# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (模板例外入库，真实凭证文件 .env.local 不入库)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地数据（投标记录、留言、DM缓存）
/data/store/
/data/cache/

# 数据快照与运行时（代码走 git，数据走 pack_snapshot 同步，两线分开）
/data/
/logs/
server.log
_tmp_*
